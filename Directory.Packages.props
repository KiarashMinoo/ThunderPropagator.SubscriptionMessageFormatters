<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- Lets the pins below override vulnerable transitive versions coming from upstream packages. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <PropertyGroup Label="ThunderPropagatorPackages">
    <ThunderPropagatorFormatSerializersVersion>$(ThunderPropagatorFloatingVersion)</ThunderPropagatorFormatSerializersVersion>
  </PropertyGroup>
  <ItemGroup Label="ThunderPropagator Packages">
    <PackageVersion Include="$(ThunderPropagatorPackageId)" Version="$(ThunderPropagatorFloatingVersion)" />
  </ItemGroup>
  <ItemGroup Label="Transitive security pins">
    <!-- GHSA-qhrr-8q5h-9q3h: FormatSerializers.MessagePack builds up to 3.1.8 pull MessagePack 3.1.8 transitively. -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
  </ItemGroup>
  <ItemGroup Label="Format Serializer Packages">
    <PackageVersion Include="$(MessagePackPackageId)" Version="$(ThunderPropagatorFormatSerializersVersion)" />
    <PackageVersion Include="$(NetJsonPackageId)" Version="$(ThunderPropagatorFormatSerializersVersion)" />
    <PackageVersion Include="$(ProtobufPackageId)" Version="$(ThunderPropagatorFormatSerializersVersion)" />
    <PackageVersion Include="$(ToonPackageId)" Version="$(ThunderPropagatorFormatSerializersVersion)" />
    <PackageVersion Include="$(XmlPackageId)" Version="$(ThunderPropagatorFormatSerializersVersion)" />
    <PackageVersion Include="$(YamlPackageId)" Version="$(ThunderPropagatorFormatSerializersVersion)" />
  </ItemGroup>
  <ItemGroup Label="Testing Packages">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
  </ItemGroup>
</Project>
